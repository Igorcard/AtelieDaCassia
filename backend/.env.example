# PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/atelie"

# App
PORT=3333

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional
TRANSACTION_TIMEOUT=10000

# --- Melhor Envio (frete) ---
# Token Bearer da API: https://docs.melhorenvio.com.br
MELHOR_ENVIO_TOKEN=
# Obrigatório pela API: nome do app + e-mail de contato
MELHOR_ENVIO_USER_AGENT="AtelieDaCassia (suporte@seuemail.com)"
# CEP de origem (loja), 8 dígitos
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=

# Gateway no banco (tabela gateways). Padrão: MELHOR_ENVIO
# SHIPPING_GATEWAY_CODE=MELHOR_ENVIO

# Restringir serviços de transporte (opcional), ex.: 1,2,18
# MELHOR_ENVIO_SERVICES=

# Cubagem padrão quando o produto não tem shippingWeightKg / shipping*Cm
MELHOR_ENVIO_DEFAULT_WEIGHT_KG=0.3
MELHOR_ENVIO_DEFAULT_LENGTH_CM=16
MELHOR_ENVIO_DEFAULT_WIDTH_CM=11
MELHOR_ENVIO_DEFAULT_HEIGHT_CM=2

# --- Mercado Pago (Checkout Pro) ---
# Token de acesso da aplicação (produção ou credenciais de teste). Apenas no servidor — não expor no client.
# Doc: https://www.mercadopago.com.br/developers/pt/reference
MERCADOPAGO_ACCESS_TOKEN=
# Segredo configurado no painel para validar webhooks (assinatura / headers conforme doc Webhooks do MP).
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública HTTPS desta API (ex.: deploy ou túnel em dev). Base para notification_url das preferências.
# Ex.: https://api.seudominio.com
API_PUBLIC_URL=
# URL pública do app React (mesma origem que o usuário vê). Base para back_urls (success / failure / pending) do Checkout Pro.
# Ex.: https://seudominio.com — deve coincidir com as rotas /payment/* do frontend.
FRONTEND_APP_URL=
